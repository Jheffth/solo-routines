# ══════════════════════════════════════════════════════════════════
#  MOLDE DO webapp/.env
#
#  Copie para `webapp/.env` e preencha. O arquivo real NUNCA vai ao git —
#  o .gitignore já barra `.env`. Este molde vai, e por isso não contém
#  nenhum valor de verdade.
#
#  No servidor: /root/app/webapp/.env, criado ANTES do próximo
#  `docker compose up -d`. Sem ele a SECRET_KEY chega vazia e o contêiner
#  se recusa a subir — de propósito, para não assinar token com chave
#  improvisada.
# ══════════════════════════════════════════════════════════════════

# ── Banco ─────────────────────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=solo_routines_db

# ── Assinatura dos tokens ─────────────────────────────────────────
# Quem tem esta chave forja sessão de qualquer usuário. Gere uma nova:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-nova

# ── Agenda do Google (opcional) ───────────────────────────────────
# Cifra o refresh token do Calendar guardado no banco. Sem ela o botão
# de conectar agenda nem aparece — de propósito: um refresh token em
# texto puro é acesso contínuo à agenda de outra pessoa.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TROCAR ESTA CHAVE invalida as conexões existentes — os hunters
# precisarão reconectar. Não é catastrófico, mas não é de graça.
CALENDARIO_CHAVE=

# ── Google OAuth (necessário para Agenda) ─────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Bots (opcional) ───────────────────────────────────────────────
# Telegram: crie o bot com o @BotFather e cole o token aqui.
# TELEGRAM_CHAT_ID deixou de ser "o único chat autorizado" — agora é uma
# LISTA DE ESPERA opcional (ids separados por vírgula). Vazio = qualquer
# um pode tentar vincular, e sem o código de 6 dígitos não passa da porta.
TELEGRAM_BOT_TOKEN=
# Só o @nome do bot, sem o arroba. Monta o link t.me/... no passo 1 da aba.
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHAT_ID=

# O Telegram devolve este segredo no cabeçalho de cada webhook, e é ele
# que separa "o Telegram falando" de "qualquer um na internet falando".
#
# NÃO TEM MAIS VALOR PADRÃO, de propósito. Quem sabe o segredo monta o
# JSON à mão com o chat_id de um hunter já vinculado e manda /ok e /add:
# conclui missões que ninguém fez e lê a rotina dele. Um default no
# código seria um segredo publicado.
#
# Vazio = o webhook recusa TUDO (503). O bot fica mudo, e isso é
# intencional: um bot mudo é um chamado de suporte; um bot que responde
# a estranhos é um estrago.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# A aba Bots acusa em vermelho se o valor for um dos de exemplo.
TELEGRAM_SECRET=

# WhatsApp via Evolution API (contêiner ao lado do app).
# NÃO é a API oficial da Meta: sem template aprovado e sem custo por
# conversa, mas o número pode ser banido se virar disparo em massa.
EVOLUTION_API_URL=http://whatsapp:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=solo_rotinas
EVOLUTION_WEBHOOK=http://app:8000/api/whats/webhook

# ── Identidade da instância ───────────────────────────────────────
# AMBIENTE  = o regime: production | staging | dev
# HOSPEDEIRO = a casa: Contabo, Render, Local...
# São coisas diferentes. Confundi-las é o que fez o rodapé anunciar
# "RENDER" rodando no Contabo.
AMBIENTE=production
HOSPEDEIRO=Contabo

CORS_ORIGINS=https://soloroutines.duckdns.org
OAUTH_REDIRECT_BASE=https://soloroutines.duckdns.org
