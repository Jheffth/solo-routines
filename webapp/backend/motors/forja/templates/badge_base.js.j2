/* ============================================================
   Forja S-Rank — Arte Gerada pelo Motor
   Insignia: {{ nome }}
   Gerado em: {{ data_geracao }}
   ============================================================ */

const {{ namespace }} = {
  _svg(tam) {
    return `
    <svg viewBox="0 0 {{ view_box }} {{ view_box }}" width="${tam}" height="${tam}"
         class="conquista-svg" aria-hidden="true" focusable="false"
         style="display:block;overflow:visible;max-width:none;width:${tam}px;height:${tam}px">
      <style>
{{ estilos_css | indent(8) }}
      </style>
      <defs>
        <filter id="shadow">
          <feDropShadow dx="0" dy="8" stdDeviation="6" flood-color="#000" flood-opacity="0.9"/>
        </filter>
        <filter id="glow">
          <feGaussianBlur stdDeviation="3"/>
        </filter>
{{ defs_extras | indent(8) }}
      </defs>

      <g filter="url(#shadow)">
{{ camadas_svg | indent(8) }}
      </g>
    </svg>`;
  },

  cerimonia() {
    console.log("Cerimônia disparada para {{ nome }}");
    const container = document.getElementById('painel-cerimonia');
    if (!container) {
      console.error("Painel de cerimônia não encontrado");
      return;
    }
    container.innerHTML = \`<div class="cq-overlay" onclick="this.remove()">
      <div class="cq-flash"></div>
      <div class="cq-palco">
        <div class="cq-sunburst"></div>
        <div class="cq-medalha forja-entering">\${this._svg({{ tamanho_cerimonia }})}</div>
        <div class="cq-textos">
          <h1 class="cq-titulo-shimmer">{{ titulo_cerimonia }}</h1>
          <p class="cq-subtitulo">{{ subtitulo_cerimonia }}</p>
        </div>
      </div>
    </div>\`;
  }
};

window.{{ namespace }} = {{ namespace }};

if (window.ConquistaFX) {
  ConquistaFX.registrarInsignia('{{ id_registro }}', tam => {{ namespace }}._svg(tam));
}
